# Copy to .env next to docker-compose.yml. Never commit .env.
TZ=UTC
# Claude Code: log in interactively once, or set one of these for unattended runs.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Pin an older plain-JS Claude Code if the native binary crashes on your CPU (see docs/architecture.md).
CLAUDE_CODE_VERSION=latest
# Telegram bot from @BotFather, and your own chat id. Used by n8n and the queue runner, never shown to Claude.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, read by bin/apply-runner.mjs.
CANDIDATE_NAME=Jane Doe
CV_FILE_PREFIX=Jane_Doe_
TRACK_ORDER=contract uk hk
RIGHT_TO_WORK_LINE=
